# Copy to .env (`make setup` does it) and adjust. Never commit .env.

# --- Local infrastructure (deploy/local/compose.yml) ---
NADJET_PG_PORT=55432
NADJET_REDIS_PORT=56379

# --- API ---
NADJET_ENV=development
NADJET_DATABASE_URL=postgresql+asyncpg://nadjet:nadjet@localhost:55432/nadjet
NADJET_REDIS_URL=redis://localhost:56379/0
# Camera stream URLs returned by GET /cameras ({path} = stream path); the video server is MediaMTX.
NADJET_RTSP_URL_TEMPLATE=rtsp://localhost:8554/{path}
NADJET_WHEP_URL_TEMPLATE=http://localhost:8889/{path}/whep

# --- AI inference: NVIDIA Brev only (AGENTS.md "AI inference") ---
# Name of the Brev instance running deploy/gpu/compose.yml (vLLM).
NADJET_BREV_INSTANCE=nadjet-gpu
# Local end of `make brev-forward` (localhost:18000 -> instance:8000). No other provider is allowed.
NADJET_VLM_BASE_URL=http://127.0.0.1:18000/v1
NADJET_VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct-FP8
# Vision workers (make brev-tunnel / brev-deploy-workers). On the instance the defaults come from
# deploy/gpu/compose.yml (RTSP 127.0.0.1:18554, API 127.0.0.1:18080 through the tunnels).
NADJET_RTSP_BASE=rtsp://127.0.0.1:8554
NADJET_API_URL=http://127.0.0.1:8080
# Detection (models are pinned in models.lock.yaml; weights are verified before loading).
NADJET_DETECTOR_MODEL=rf-detr-medium
NADJET_DETECTOR_THRESHOLD=0.4
NADJET_SAMPLE_FPS=5
# ffmpeg encoder of the annotated <camera>_ai stream: h264_nvenc on the GPU host, libx264 on a CPU.
NADJET_ANNOTATED_ENCODER=h264_nvenc
# No analysed frame for this long (seconds) marks the camera as faulty.
NADJET_STALL_S=10
# Camera i serves Prometheus /metrics on base+i.
NADJET_METRICS_PORT_BASE=9100
# Optional: pin the worker image, e.g. ghcr.io/nadjeet/nadjet-vision:<sha>
# NADJET_VISION_IMAGE=ghcr.io/nadjeet/nadjet-vision:dev
# Optional tunnel ports (scripts/brev.sh tunnel): local MediaMTX/API and their ports on the instance
# NADJET_RTSP_LOCAL_PORT=8554
# NADJET_API_LOCAL_PORT=8080
# NADJET_RTSP_REMOTE_PORT=18554
# NADJET_API_REMOTE_PORT=18080

# --- Auth (FR-SEC-001) ---
# HS256 signing key. Optional in development/test, REQUIRED (>= 32 chars) in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NADJET_JWT_SECRET=
NADJET_ACCESS_TOKEN_TTL_MINUTES=30

# --- Incident engine (FR-INC, FR-SEC-003) ---
# Service token for vision workers calling /internal/* (Authorization: Bearer ...). Unset = disabled.
NADJET_INGEST_TOKEN=dev-ingest-token-change-me
# Where evidence files are stored (local volume) and the max upload size.
NADJET_EVIDENCE_DIR=evidence
NADJET_EVIDENCE_MAX_MB=100
# Ed25519 seed (64 hex chars) signing incident chain heads. REQUIRED in production.
# Generate with: uv run nadjet-api gen-signing-key
NADJET_SIGNING_KEY=
