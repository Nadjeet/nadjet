# Copy to .env (`make setup` does it) and adjust. Never commit .env.

# --- Local infrastructure (deploy/local/compose.yml) ---
NADJET_PG_PORT=55432
NADJET_REDIS_PORT=56379

# --- API ---
NADJET_ENV=development
NADJET_DATABASE_URL=postgresql+asyncpg://nadjet:nadjet@localhost:55432/nadjet
NADJET_REDIS_URL=redis://localhost:56379/0
# Camera stream URLs returned by GET /cameras ({path} = stream path); the video server is MediaMTX.
NADJET_RTSP_URL_TEMPLATE=rtsp://localhost:8554/{path}
NADJET_WHEP_URL_TEMPLATE=http://localhost:8889/{path}/whep
# LL-HLS fallback for the camera wall when WebRTC (UDP) is blocked.
NADJET_HLS_URL_TEMPLATE=http://localhost:8888/{path}/index.m3u8

# --- AI inference: NVIDIA Brev only (AGENTS.md "AI inference") ---
# Name of the Brev instance running deploy/gpu/compose.yml (vLLM).
NADJET_BREV_INSTANCE=nadjet-gpu
# Local end of `make brev-forward` (localhost:18000 -> instance:8000). No other provider is allowed.
NADJET_VLM_BASE_URL=http://127.0.0.1:18000/v1
NADJET_VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct-FP8
# Per-call HTTP timeout, whole verification budget per candidate (SC-001), and how long the
# workers answer 'AI unavailable' at once after a timeout or an unreachable server (FR-VIS-009).
# NADJET_VLM_TIMEOUT_S=15
# NADJET_VLM_BUDGET_S=15
# NADJET_VLM_BACKOFF_S=30
# Vision workers (make brev-tunnel / brev-deploy-workers). On the instance the defaults come from
# deploy/gpu/compose.yml (RTSP 127.0.0.1:18554, API 127.0.0.1:18080 through the tunnels).
NADJET_RTSP_BASE=rtsp://127.0.0.1:8554
NADJET_API_URL=http://127.0.0.1:8080
# Detection (models are pinned in models.lock.yaml; weights are verified before loading).
NADJET_DETECTOR_MODEL=rf-detr-medium
NADJET_DETECTOR_THRESHOLD=0.4
NADJET_SAMPLE_FPS=5
# ffmpeg encoder of the annotated <camera>_ai stream: h264_nvenc on the GPU host, libx264 on a CPU.
NADJET_ANNOTATED_ENCODER=h264_nvenc
# No analysed frame for this long (seconds) marks the camera as faulty.
NADJET_STALL_S=10
# Camera i serves Prometheus /metrics on base+i.
NADJET_METRICS_PORT_BASE=9100
# Crash triggers and evidence (thresholds per camera: `triggers:` in data/cameras.yaml, see TD-39).
# Repeat-trigger cooldown per camera, seconds; clip around the impact; encoded-packet ring.
NADJET_TRIGGER_COOLDOWN_S=120
NADJET_EVIDENCE_BEFORE_S=10
NADJET_EVIDENCE_AFTER_S=5
NADJET_EVIDENCE_KEYFRAMES=6
NADJET_EVIDENCE_BUFFER_S=20
# AI verifier and sweep (Brev only): verify every rule candidate, sweep every camera.
NADJET_VERIFY_CANDIDATES=true
NADJET_SWEEP_ENABLED=true
NADJET_SWEEP_EVERY_S=8
# Yes-token probability thresholds (starting values, TQ-07 is open).
NADJET_SWEEP_YES_THRESHOLD=0.5
NADJET_STATUS_CONFIRMED=0.8
NADJET_STATUS_PROBABLE=0.5
# false = detect and log only (no candidates or evidence sent to the API)
NADJET_PUBLISH_CANDIDATES=true
# Optional: pin the worker image, e.g. ghcr.io/nadjeet/nadjet-vision:<sha>
# NADJET_VISION_IMAGE=ghcr.io/nadjeet/nadjet-vision:dev
# Optional tunnel ports (scripts/brev.sh tunnel): local MediaMTX/API and their ports on the instance
# NADJET_RTSP_LOCAL_PORT=8554
# NADJET_API_LOCAL_PORT=8080
# NADJET_RTSP_REMOTE_PORT=18554
# NADJET_API_REMOTE_PORT=18080

# --- Auth (FR-SEC-001) ---
# HS256 signing key. Optional in development/test, REQUIRED (>= 32 chars) in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NADJET_JWT_SECRET=
NADJET_ACCESS_TOKEN_TTL_MINUTES=30

# --- Incident engine (FR-INC, FR-SEC-003) ---
# Service token for vision workers calling /internal/* (Authorization: Bearer ...). Unset = disabled.
NADJET_INGEST_TOKEN=dev-ingest-token-change-me
# Where evidence files are stored (local volume) and the max upload size.
NADJET_EVIDENCE_DIR=evidence
# Public try-it sandbox (FR-CIT-002..004): isolated store, limits and the 1 h deletion.
NADJET_TRY_DIR=try-sandbox
NADJET_TRY_MAX_MB=100
NADJET_TRY_MAX_SECONDS=60
NADJET_TRY_TTL_S=3600
NADJET_TRY_JOBS_PER_MINUTE=5
# Abuse guards of the public sandbox: per-IP limits, global caps (503 beyond), progress streams
# NADJET_TRY_SESSIONS_PER_MINUTE=5
# NADJET_TRY_MAX_OPEN_JOBS=20
# NADJET_TRY_MAX_LIVE_SESSIONS=3
# NADJET_TRY_EVENTS_PER_MINUTE=30
# NADJET_TRY_EVENTS_MAX_S=120
# NADJET_TRY_SESSION_IDLE_S=30
# NADJET_TRY_JOB_TIMEOUT_S=300
# NADJET_TRY_PURGE_INTERVAL_S=60
# Placeholder map position of live demo phones (labelled "live demo", never a real camera)
# NADJET_LIVE_DEMO_LAT=36.7538
# NADJET_LIVE_DEMO_LON=3.0588
# Browser publish URL of a phone camera (WHIP) and the AI check interval of a live session.
NADJET_WHIP_URL_TEMPLATE=http://localhost:8889/{path}/whip
NADJET_LIVE_CHECK_S=4
# Where `make eval` writes results and `GET /evaluation/latest` reads them.
NADJET_EVALUATION_DIR=eval/results
NADJET_EVIDENCE_MAX_MB=100
# Ed25519 seed (64 hex chars) signing incident chain heads. REQUIRED in production.
# Generate with: uv run nadjet-api gen-signing-key
NADJET_SIGNING_KEY=

# --- Map and routing (FR-MAP-001, FR-DSP-001) ---
# Host port of the local OSRM container (make routing-up) and the URL the API uses.
NADJET_OSRM_PORT=55000
NADJET_OSRM_URL=http://localhost:55000
NADJET_ROUTING_TIMEOUT_S=5
# OSRM has no live traffic: free-flow durations are multiplied by this factor (docs/11 TD-38).
NADJET_ROUTING_URBAN_MULTIPLIER=1.3
# Offline basemap built by make map-data and served at /tiles/algeria.pmtiles.
NADJET_MAP_TILES_PATH=data/map/algeria.pmtiles

# --- Citizen reports (FR-CIT-004) ---
# Per client IP: reports allowed per window (seconds) on POST /public/reports; photo size cap.
NADJET_PUBLIC_REPORT_RATE_LIMIT=5
NADJET_PUBLIC_REPORT_WINDOW_S=600
NADJET_PUBLIC_PHOTO_MAX_MB=10
# SMS fallback of the public report page: the gateway SIM number, baked into the web build.
VITE_SMS_GATEWAY_NUMBER=

# --- Notifications (FR-NTF, TD-13/14/39) ---
# Self-hosted SMS gateway (capcom6, private mode): `make infra-sms`, then pair the phone (docs/ONBOARDING.md).
# Leave NADJET_SMS_GATEWAY_URL empty to disable SMS. User/password are shown in the Android app after sign-up.
NADJET_SMS_GATEWAY_URL=
NADJET_SMS_GATEWAY_USER=
NADJET_SMS_GATEWAY_PASSWORD=
# Number of the gateway SIM: the responder app opens the SMS app addressed to it (offline fallback).
NADJET_SMS_GATEWAY_NUMBER=
# Signing key of the gateway webhooks (app: Settings > Webhooks). /sms/* return 503 when unset.
NADJET_SMS_WEBHOOK_SECRET=
# Used only by the compose profile `sms`.
NADJET_SMS_PRIVATE_TOKEN=change-me
NADJET_SMS_DB_PASSWORD=nadjet-sms-dev
NADJET_SMS_PORT=53000
# Web Push: generate with `uv run nadjet-api gen-vapid`.
NADJET_VAPID_PRIVATE_KEY=
NADJET_VAPID_PUBLIC_KEY=
NADJET_VAPID_SUBJECT=mailto:ops@nadjet.example
# Optional Telegram Bot API channel.
NADJET_TELEGRAM_BOT_TOKEN=
# Resend an undelivered notification after this many seconds (doubling), up to this many retries.
NADJET_NOTIFY_RETRY_BASE_S=30
NADJET_NOTIFY_MAX_RETRIES=3

# --- Retention (FR-SEC-005) ---
NADJET_RETENTION_DAYS=90
# NADJET_RETENTION_INTERVAL_S=3600
