#!/usr/bin/env python3
"""Git commit-msg hook (all agents and humans): one-line Conventional Commit, no trailers.

Installed by `make setup` (git config core.hooksPath .githooks).
"""

import re
import sys

CONVENTIONAL = re.compile(
    r"^(feat|fix|refactor|perf|test|docs|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: \S.{0,70}$"
)
TRAILER = re.compile(r"co-authored-by|generated with|signed-off-by", re.IGNORECASE)


def validate(message: str) -> str | None:
    """Return an error message, or None when the commit message is valid."""
    lines = [ln for ln in message.splitlines() if ln.strip() and not ln.startswith("#")]
    if not lines:
        return "empty commit message"
    if lines[0].startswith(("Merge ", 'Revert "')):
        return None  # generated by git itself
    if TRAILER.search(message):
        return "co-author/trailer lines are not allowed"
    if len(lines) > 1:
        return "commit message must be a single line (no body)"
    if not CONVENTIONAL.match(lines[0]):
        return f"not a Conventional Commit 'type(scope): summary' (max 72 chars): {lines[0]!r}"
    return None


def main() -> int:
    with open(sys.argv[1], encoding="utf-8") as fh:
        error = validate(fh.read())
    if error:
        print(f"commit-msg: {error}. See AGENTS.md › Git rules.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
