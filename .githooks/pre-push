#!/usr/bin/env bash
# Block pushes to dev/main and non-fast-forward (force) pushes.
# Override (humans, repo bootstrap only): NADJET_ALLOW_PROTECTED=1 git push ...
zero=0000000000000000000000000000000000000000
[ "${NADJET_ALLOW_PROTECTED:-0}" = "1" ] && exit 0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/dev)
      echo "pre-push: never push directly to ${remote_ref#refs/heads/}; open a PR targeting dev." >&2
      exit 1
      ;;
  esac
  if [ "$local_sha" = "$zero" ]; then
    echo "pre-push: deleting remote branches is reserved for the /review-pr cleanup step (gh)." >&2
    exit 1
  fi
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha" 2>/dev/null &&
    ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    echo "pre-push: non-fast-forward push to ${remote_ref#refs/heads/} refused (no force pushes)." >&2
    exit 1
  fi
done
exit 0
