{
  "$defs": {
    "AiStatus": {
      "description": "Graded AI status (PRD FR-VIS-007). The AI alone never yields ``confirmed``.",
      "enum": [
        "confirmed",
        "probable",
        "possible",
        "insufficient_evidence"
      ],
      "title": "AiStatus",
      "type": "string"
    },
    "CandidateSource": {
      "enum": [
        "camera",
        "citizen",
        "operator"
      ],
      "title": "CandidateSource",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "clip_path": {
          "title": "Clip Path",
          "type": "string"
        },
        "keyframe_paths": {
          "items": {
            "type": "string"
          },
          "title": "Keyframe Paths",
          "type": "array"
        },
        "sha256": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "file path -> SHA-256",
          "title": "Sha256",
          "type": "object"
        }
      },
      "required": [
        "clip_path"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "One statement of the verifier, tied to the frames it was read from (FR-VIS-016).",
      "properties": {
        "basis": {
          "pattern": "^(observed|inferred)$",
          "title": "Basis",
          "type": "string"
        },
        "frame_ids": {
          "description": "Frames of the verifier video",
          "items": {
            "type": "integer"
          },
          "title": "Frame Ids",
          "type": "array"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "basis"
      ],
      "title": "Finding",
      "type": "object"
    },
    "GeoLocation": {
      "additionalProperties": false,
      "description": "Where the event happened (FR-INC-001).",
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "pk_km": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pk Km"
        },
        "road": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Road"
        },
        "wilaya": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wilaya"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "GeoLocation",
      "type": "object"
    },
    "TriggerType": {
      "description": "Rule triggers (PRD FR-VIS-004) plus the AI sweep (FR-VIS-015).",
      "enum": [
        "collision_candidate",
        "hard_stop",
        "stalled_vehicle",
        "pedestrian_on_road",
        "ai_sweep",
        "citizen_report",
        "operator_report"
      ],
      "title": "TriggerType",
      "type": "string"
    },
    "VerifierResult": {
      "additionalProperties": false,
      "description": "Outcome of one call to the AI verifier (or of a failed call).",
      "properties": {
        "available": {
          "description": "False when the verifier timed out or was unreachable",
          "title": "Available",
          "type": "boolean"
        },
        "collision_visible": {
          "anyOf": [
            {
              "pattern": "^(yes|no|cannot_judge)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Verifier verdict",
          "title": "Collision Visible"
        },
        "description_ar": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description Ar"
        },
        "description_fr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description Fr"
        },
        "findings": {
          "description": "Cited findings; a raise without one is ignored",
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "invalid": {
          "default": false,
          "description": "True when the answer failed validation twice (template text)",
          "title": "Invalid",
          "type": "boolean"
        },
        "lanes_blocked": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lanes Blocked"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model id that produced the answer",
          "title": "Model"
        },
        "not_assessable": {
          "description": "What the video does not let anyone judge",
          "items": {
            "type": "string"
          },
          "title": "Not Assessable",
          "type": "array"
        },
        "priority_raise": {
          "default": 0,
          "description": "Levels the verifier asks to raise priority (max 1)",
          "maximum": 1,
          "minimum": 0,
          "title": "Priority Raise",
          "type": "integer"
        },
        "t_contact": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Contact time in seconds on the frame stamps: relative to the rule moment for a rule candidate, to the window end for a sweep (negative = before)",
          "title": "T Contact"
        },
        "type": {
          "anyOf": [
            {
              "pattern": "^(collision|rollover|fire|stalled|pedestrian|none)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the verifier sees",
          "title": "Type"
        },
        "vehicles_involved": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vehicles Involved"
        },
        "yes_probability": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Probability of the 'yes' answer token (logprobs)",
          "title": "Yes Probability"
        }
      },
      "required": [
        "available"
      ],
      "title": "VerifierResult",
      "type": "object"
    },
    "Witness": {
      "additionalProperties": false,
      "description": "Answers from a citizen or responder on scene (FR-CIT-006).",
      "properties": {
        "people_reported": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "People Reported"
        },
        "trapped": {
          "default": false,
          "title": "Trapped",
          "type": "boolean"
        }
      },
      "title": "Witness",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A candidate incident from a camera, a citizen or an operator (FR-VIS-006, FR-INC-001).",
  "properties": {
    "ai_status": {
      "$ref": "#/$defs/AiStatus",
      "default": "insufficient_evidence"
    },
    "camera_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Camera Id"
    },
    "detected_at": {
      "format": "date-time",
      "title": "Detected At",
      "type": "string"
    },
    "event_time": {
      "description": "Best estimate of the impact time",
      "format": "date-time",
      "title": "Event Time",
      "type": "string"
    },
    "evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/Evidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "location": {
      "$ref": "#/$defs/GeoLocation"
    },
    "signals": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "Named rule signals and their measured values",
      "title": "Signals",
      "type": "object"
    },
    "source": {
      "$ref": "#/$defs/CandidateSource",
      "default": "camera"
    },
    "track_ids": {
      "items": {
        "type": "integer"
      },
      "title": "Track Ids",
      "type": "array"
    },
    "trigger": {
      "$ref": "#/$defs/TriggerType"
    },
    "verifier": {
      "$ref": "#/$defs/VerifierResult"
    },
    "witness": {
      "anyOf": [
        {
          "$ref": "#/$defs/Witness"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "location",
    "trigger",
    "event_time",
    "detected_at"
  ],
  "title": "IncidentCandidate",
  "type": "object"
}
