# Production variables for deploy/vps/compose.yml. Paste into Dokploy → Environment.
# NEVER commit real values. Generate secrets with `openssl rand -hex 32`.

NADJET_TAG=demo-v1
NADJET_DOMAIN=example.dz            # app./respond./hospital./try./api./stream./hls./sms. live under it
NADJET_PUBLIC_HOST=203.0.113.7      # VPS public IP (advertised for WebRTC ICE)

NADJET_DB_PASSWORD=
NADJET_JWT_SECRET=                  # >= 32 chars
NADJET_SIGNING_KEY=                 # `nadjet-api gen-signing-key`
NADJET_INGEST_TOKEN=                # service password: Brev workers, camsim publishers, MediaMTX
NADJET_STREAM_SERVICE_USER=nadjet-worker
NADJET_STREAM_TOKEN_TTL_S=300
NADJET_ACCESS_TOKEN_TTL_MINUTES=30

NADJET_SMS_DB_PASSWORD=
NADJET_SMS_PRIVATE_TOKEN=
NADJET_SMS_GATEWAY_USER=
NADJET_SMS_GATEWAY_PASSWORD=
NADJET_SMS_WEBHOOK_SECRET=

# Optional notifications
NADJET_VAPID_PRIVATE_KEY=
NADJET_VAPID_PUBLIC_KEY=
NADJET_VAPID_SUBJECT=mailto:ops@example.dz
NADJET_TELEGRAM_BOT_TOKEN=
